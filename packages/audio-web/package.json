{
  "name": "@raucheacho/goul-audio-web",
  "version": "1.0.1",
  "description": "Goul's audio core for the browser: Opus, framing and jitter buffer in WebAssembly, plus the AudioWorklets that run it.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raucheacho/goul.git",
    "directory": "packages/audio-web"
  },
  "homepage": "https://github.com/raucheacho/goul/tree/main/packages/audio-web#readme",
  "keywords": [
    "opus",
    "webassembly",
    "audio",
    "push-to-talk",
    "jitter-buffer",
    "audioworklet",
    "voice"
  ]
}
